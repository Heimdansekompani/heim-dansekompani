# Firebase web app config (Project settings > General > Your apps > SDK setup and configuration)
# These are safe to expose to the browser (hence NEXT_PUBLIC_), but keep them out of source
# control anyway so they can be rotated per-environment without a code change.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Cloudinary (Dashboard > Settings > API Keys). Cloud name and API key are not
# secret (they accompany a signature client-side); API secret is server-only
# and must never get a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
