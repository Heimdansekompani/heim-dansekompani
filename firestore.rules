rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // One doc per account, doc ID == Firebase Auth uid. This is what lets a
    // user "self-verify" by reading their own doc (used both by the /admin
    // route guard and by the Cloudinary signing route, which has no Admin
    // SDK available and instead calls the Firestore REST API with the
    // caller's own ID token).
    match /users/{uid} {
      allow read: if request.auth != null
        && (request.auth.uid == uid || isSignedInAdmin());
      // A signed-in user may create only their own doc, and it must land
      // exactly as 'pending' — every other role requires an existing admin
      // to promote them via /admin/administratorer.
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.role == 'pending';
      // A signed-in user may also update their own doc directly (profile
      // name/address/photo), but not their own role — that still requires
      // an existing admin. The email field may only be written to match
      // the caller's own verified Auth token email, so it can't be forged
      // and stays in sync once a verify-first email change completes.
      allow update: if isSignedInAdmin() || isValidSelfProfileUpdate(uid);
      allow delete: if isSignedInAdmin();
    }

    // Doc ID is the project's slug. Published projects are publicly
    // readable; drafts and all writes require editor or admin. (Managing
    // *who* has editor/admin access is still admin-only, via users/{uid}.)
    match /projects/{slug} {
      allow read: if resource.data.published == true || isEditorOrAbove();
      allow write: if isEditorOrAbove();

      // Per-date seat counter: { taken: int }. Capacity lives on the parent
      // project doc (performanceDates[dateId].capacity — a map keyed by
      // dateId precisely so these rules can index it). Publicly readable
      // (a count, no PII — needed for remaining-seat display). Anonymous
      // writes may only move `taken` upward by the size of one registration
      // (1–10 tickets) and never past capacity; the registration-create rule
      // below ties the two writes together into one transaction via
      // getAfter(). Editors may write freely: cancellation decrements,
      // drift repair, and cleanup of removed dates.
      match /attendance/{dateId} {
        allow read: if true;
        allow write: if isEditorOrAbove();
        allow create: if isOpenForRegistration(slug, dateId)
          && request.resource.data.keys().hasOnly(['taken'])
          && request.resource.data.taken is int
          && request.resource.data.taken >= 1
          && request.resource.data.taken <= 10
          && request.resource.data.taken <= dateCapacity(slug, dateId);
        allow update: if isOpenForRegistration(slug, dateId)
          && request.resource.data.keys().hasOnly(['taken'])
          && request.resource.data.taken is int
          && request.resource.data.taken >= resource.data.taken + 1
          && request.resource.data.taken <= resource.data.taken + 10
          && request.resource.data.taken <= dateCapacity(slug, dateId);
      }

      // Public event registrations (names + emails). Anyone can create one,
      // but only as part of a transaction that also bumps the attendance
      // counter by exactly `tickets` — see isValidRegistrationCreate — so
      // capacity can never oversell. Nobody unauthenticated can ever read a
      // registration back. Updates are disabled until a payment flow needs
      // status transitions (that's a rules change, not a data migration).
      match /registrations/{registrationId} {
        allow read, delete: if isEditorOrAbove();
        allow update: if false;
        allow create: if isValidRegistrationCreate(slug, request.resource.data);
      }
    }

    // The whole "Personer" team list as a single doc — this is the public
    // page's actual content, so it's publicly readable. Only editor/admin
    // can write it.
    match /settings/personer {
      allow read: if true;
      allow write: if isEditorOrAbove();
    }

    // The "Om" (about) page content as a single doc, built from the same
    // flexible media+richText sections as projects — see settings/personer
    // above for the equivalent pattern. Publicly readable, editor/admin write.
    match /settings/om {
      allow read: if true;
      allow write: if isEditorOrAbove();
    }

    // Public contact form submissions: anyone can create one entry, but
    // nobody (including the submitter) can read, update, or delete it back
    // through the client SDK. Reading submissions should go through an
    // authenticated admin view or the Firebase console.
    match /contactSubmissions/{submissionId} {
      allow create: if isValidContactSubmission(request.resource.data);
      allow read, update, delete: if isSignedInAdmin();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidContactSubmission(data) {
      return data.keys().hasOnly(['name', 'email', 'message', 'createdAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.email is string && data.email.size() > 0 && data.email.size() <= 320
        && data.message is string && data.message.size() > 0 && data.message.size() <= 5000
        && data.createdAt == request.time;
    }

    function projectData(slug) {
      return get(/databases/$(database)/documents/projects/$(slug)).data;
    }

    // Registration is open when the project is published, the toggle is on,
    // the date exists, and it hasn't started yet. get('field', default)
    // keeps this safe on project docs that predate the event fields.
    function isOpenForRegistration(slug, dateId) {
      return projectData(slug).published == true
        && projectData(slug).get('registrationEnabled', false) == true
        && dateId in projectData(slug).get('performanceDates', {})
        && projectData(slug).performanceDates[dateId].startsAt > request.time;
    }

    function dateCapacity(slug, dateId) {
      return projectData(slug).performanceDates[dateId].capacity;
    }

    function attendanceTakenBefore(slug, dateId) {
      return exists(/databases/$(database)/documents/projects/$(slug)/attendance/$(dateId))
        ? get(/databases/$(database)/documents/projects/$(slug)/attendance/$(dateId)).data.taken
        : 0;
    }

    // Post-transaction state of the counter — this is what ties a
    // registration create to its counter increment: if the same transaction
    // didn't move `taken` up by exactly `tickets`, the create is denied.
    function attendanceTakenAfter(slug, dateId) {
      return getAfter(/databases/$(database)/documents/projects/$(slug)/attendance/$(dateId)).data.taken;
    }

    // The tickets range (1–10) is mirrored in lib/registration.ts
    // MAX_TICKETS_PER_REGISTRATION — change both together.
    function isValidRegistrationCreate(slug, data) {
      return isOpenForRegistration(slug, data.dateId)
        && data.keys().hasOnly(['name', 'email', 'tickets', 'dateId',
             'projectSlug', 'projectTitle', 'status', 'pricePerTicket', 'createdAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 320
        && data.tickets is int && data.tickets >= 1 && data.tickets <= 10
        && data.dateId is string
        && data.projectSlug == slug
        && data.projectTitle is string && data.projectTitle.size() <= 300
        && data.status == 'confirmed'
        && data.pricePerTicket == null
        && data.createdAt == request.time
        && attendanceTakenAfter(slug, data.dateId)
             == attendanceTakenBefore(slug, data.dateId) + data.tickets
        && attendanceTakenAfter(slug, data.dateId) <= dateCapacity(slug, data.dateId);
    }

    function isSignedInAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isEditorOrAbove() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'editor'];
    }

    // A user editing their own doc can change name/address/photo, but the
    // role field must stay exactly what it already was (no self-promotion),
    // and the email field may only ever be written to match their own
    // current Auth token email — never an arbitrary value — so it can't be
    // forged, only kept in sync after a verified email change.
    function isValidSelfProfileUpdate(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
        && request.resource.data.keys().hasOnly(['email', 'role', 'createdAt', 'name', 'address', 'photo']);
    }
  }
}
